/* IwanMoney Dark Theme - Slate 900 */
* { font-family: "Inter", "Microsoft YaHei UI", "Segoe UI", sans-serif; }
QMainWindow { background: #0F172A; }
#centralwidget { background: #0F172A; }
#headerWidget { background: #1E293B; border: 1px solid #334155; border-radius: 12px; }
#labelAppTitle { color: #F1F5F9; font-size: 15px; font-weight: 700; }
#labelAppSubtitle { color: #94A3B8; font-size: 11px; }
#btnTheme { background: #334155; border: 1px solid #475569; border-radius: 8px; color: #E2E8F0; }
#btnTheme:hover { background: #475569; }
#leftPanel { background: #1E293B; border: 1px solid #334155; border-radius: 12px; }
QLabel { color: #CBD5E1; }
#labelTitle { color: #F1F5F9; }
#labelBlogger, #labelDate, #labelArticle, #labelLog { color: #94A3B8; }
QComboBox, QDateEdit { background: #0F172A; border: 1.5px solid #334155; border-radius: 8px; color: #F1F5F9; }
QComboBox:hover, QDateEdit:hover { border-color: #475569; }
QComboBox:focus, QDateEdit:focus { border-color: #6366F1; }
QComboBox QAbstractItemView { background: #1E293B; border: 1px solid #334155; color: #E2E8F0; selection-background-color: #4338CA; }
QListWidget { background: #0F172A; border: 1.5px solid #334155; border-radius: 10px; color: #E2E8F0; }
QListWidget::item { background: #1E293B; border: 1px solid transparent; color: #CBD5E1; }
QListWidget::item:hover { background: #334155; }
QListWidget::item:selected { background: #312E81; border-color: #4338CA; color: #E0E7FF; }
#lineEditTitle { background: #1E293B; border: 1.5px solid #334155; color: #F1F5F9; border-radius: 10px; }
#lineEditTitle:focus { border-color: #6366F1; }
QSplitter::handle { background: #334155; }
#originalContainer, #polishedContainer { background: #1E293B; border: 1.5px solid #334155; border-radius: 12px; }
#labelOriginal { background: #0F172A; color: #94A3B8; border-bottom: 1px solid #1E293B; }
#labelPolished { background: #1E1B4B; color: #A78BFA; border-bottom: 1px solid #312E81; }
QTextEdit { background: #0F172A; border: 1px solid #334155; color: #E2E8F0; border-radius: 10px; selection-background-color: #6366F1; }
QTextEdit:focus { border-color: #6366F1; }
#textEditLog { background: #020617; border: 1px solid #1E293B; color: #94A3B8; }
QPushButton:disabled { background: #1E293B; color: #475569; border: 1px solid #334155; }
#btnCrawl { background: #0EA5E9; color: #FFFFFF; }
#btnCrawl:hover { background: #0284C7; }
#btnPolish { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #7C3AED, stop:1 #4F46E5); color: #FFFFFF; }
#btnPublish { background: #10B981; color: #FFFFFF; }
#btnClear, #btnSwap { background: #1E293B; border: 1.5px solid #334155; color: #CBD5E1; }
#btnClear:hover, #btnSwap:hover { background: #334155; color: #F1F5F9; }
QProgressBar { background: #1E293B; }
QProgressBar::chunk { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #8B5CF6, stop:1 #6366F1); }
QScrollBar:vertical { background: #0F172A; }
QScrollBar::handle:vertical { background: #334155; }
QScrollBar::handle:vertical:hover { background: #475569; }
QStatusBar { background: #1E293B; border-top: 1px solid #334155; color: #94A3B8; }
QMenuBar { background: #1E293B; border-bottom: 1px solid #334155; color: #CBD5E1; }
QMenu { background: #1E293B; border: 1px solid #334155; color: #E2E8F0; }
